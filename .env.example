# Database Configuration
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/promptler_auth
# For sync operations (Alembic migrations)
SYNC_DATABASE_URL=postgresql://username:password@localhost:5432/promptler_auth

# API Security
API_SECRET_KEY=your-secure-random-secret-key-change-this-in-production
API_KEYS=key1,key2,key3  # Comma-separated list of valid API keys for the iOS app
# Server-side only, never in an app build: lets the operator PATCH/DELETE a user
# without that user's Apple identity token (e.g. a GDPR request by email).
ADMIN_API_KEYS=generate-with-secrets-token_urlsafe-32
# Keep true in production: sign-in must carry a valid Apple identity token.
REQUIRE_IDENTITY_TOKEN=true

# Apple Sign-In Configuration
APPLE_BUNDLE_ID=com.promptler.app
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_JWKS_CACHE_TTL=3600  # Cache JWKS for 1 hour

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100

# Application
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Sentry (Optional)
# SENTRY_DSN=your-sentry-dsn-here
